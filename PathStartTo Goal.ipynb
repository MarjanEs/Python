    "def write_to_file(file_name: str | Path, path: Grid) -> None:\n",
    "    \"\"\"Write a map with a drawn search path to a ``.txt`` file.\n",
    "\n",
    "    Use it for the path to a single goal as well as for the fully explored\n",
    "    map: call it once per map, with a different file name each time, e.g.\n",
    "    ``write_to_file(\"out/map1_goal1.txt\", path_map)`` and\n",
    "    ``write_to_file(\"out/map1_explored.txt\", explored_map)``. The file is\n",
    "    written as UTF-8 (needed for the box-drawing characters), one map row\n",
    "    per line. Missing folders are created, an existing file is overwritten.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    file_name : str or Path\n",
    "        Name of the text file to create, e.g. ``\"out/map1_explored.txt\"``.\n",
    "    path : List[List[str]]\n",
    "        Map to save, indexed ``path[row][col]``, usually after it was\n",
    "        filled with ``assign_character``. Rows may also be plain strings.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    None\n",
    "    \"\"\"\n",
    "    out = Path(file_name)\n",
    "    out.parent.mkdir(parents=True, exist_ok=True)\n",
    "    with open(out, \"w\", encoding=\"utf-8\") as f:\n",
    "        f.write(\"\\n\".join(\"\".join(row) for row in path) + \"\\n\")\n",
    "        \n",
    "\n",
    "#For the path to each goal, need a copy of the map in which only the route from S to that goal is drawn.\n",
    "#This optional helper builds it from the came_from dictionary that searches will fill\n",
    "def render_path(maze_map: Grid, came_from: Dict[Position, Optional[Position]],\n",
    "                goal: Position) -> Grid:\n",
    "    \"\"\"Return a copy of ``maze_map`` with only the route start -> goal drawn.\n",
    "\n",
    "    ``came_from`` maps every visited node to its parent (``None`` for the\n",
    "    start). Raises ``KeyError`` if ``goal`` was never reached.\n",
    "    \"\"\"\n",
    "    if goal not in came_from:\n",
    "        raise KeyError(f\"goal {goal} was never reached\")\n",
    "    grid = [row[:] for row in maze_map]\n",
    "    node = goal\n",
    "    while came_from[node] is not None:\n",
    "        assign_character(grid, node, came_from[node])\n",
    "        node = came_from[node]\n",
    "    return grid        "
   ]
  },
