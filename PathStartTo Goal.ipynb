    "## Iterative Deepening Search [20 Points]\n",
    "\n",
    "Implement *Iterative Deepening Search*. Make sure to fill the docstring of the function and add typehints such that one can understand what arguments are expected and what it returns.\n",
    "\n",
    "Run the search algorithm for each map and save the results into `./data/results/<search_algo_name>_<map_number>.txt`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "a0b6cf8d-c443-4bf2-bcd4-3cf712519d95",
   "metadata": {},
   "outputs": [],
   "source": [
    "from typing import Dict, List, Set, Tuple\n",
    "\n",
    "# Node, find_start, mazemaptotree, assign_character and GOAL / Position / Grid /\n",
    "# Graph come from the code above.\n",
    "\n",
    "\n",
    "def depth_limited_search(graph: Graph, start_node: Node,\n",
    "                         limit: int) -> Tuple[Dict[Position, Node], List[Node]]:\n",
    "    \"\"\"Depth-first search that never goes deeper than ``limit`` steps.\n",
    "\n",
    "    A cell is expanded again if it is reached by a shorter path than before.\n",
    "    Without that rule the search would walk all simple paths of the open\n",
    "    rooms, which is far too slow. After the search, every cell within\n",
    "    ``limit`` steps of the start is known with its shortest path.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    graph : Dict[Tuple[int, int], List[Tuple[int, int]]]\n",
    "        Successors of every walkable cell, from ``mazemaptotree``.\n",
    "    start_node : Node\n",
    "        Root of the search tree.\n",
    "    limit : int\n",
    "        Maximum depth; nodes at this depth are not expanded.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    best : Dict[Tuple[int, int], Node]\n",
    "        For every reached cell the node with the smallest depth found.\n",
    "    order : List[Node]\n",
    "        All accepted nodes in the order the depth-first search reached them.\n",
    "    \"\"\"\n",
    "    best: Dict[Position, Node] = {}\n",
    "    order: List[Node] = []\n",
    "    stack: List[Node] = [start_node]                    # LIFO frontier\n",
    "    while stack:\n",
    "        node = stack.pop()\n",
    "        known = best.get(node.position)\n",
    "        if known is not None and known.depth <= node.depth:\n",
    "            continue                                    # already reached as quickly\n",
    "        best[node.position] = node\n",
    "        order.append(node)\n",
    "        if node.depth < limit:\n",
    "            for child_pos in reversed(graph[node.position]):\n",
    "                stack.append(Node(child_pos, node, node.depth + 1))\n",
    "    return best, order\n",
    "\n",
    "\n",
    "def iterative_deepening_depth_first_search(maze_map: Grid, monitor: bool = False) -> List[Node]:\n",
    "    \"\"\"Iterative deepening depth-first search (IDDFS) on the maze.\n",
    "\n",
    "    The key point about IDDFS is that it runs a depth-limited depth-first\n",
    "    search with an incrementing depth limit (0, 1, 2, ...). It therefore\n",
    "    explores the nodes basically breadth first, so the path to every goal\n",
    "    is a shortest one, but it uses the stack-based procedure of DFS.\n",
    "    The nodes of the shallow levels are visited again in every iteration,\n",
    "    which costs time but no extra search structure.\n",
    "\n",
    "    The agent does not know where the goals are. It only recognises a goal\n",
    "    when it reaches a ``*`` cell. The limit is raised until an iteration\n",
    "    shows that no reached cell has an unexplored neighbour left, so all\n",
    "    reachable goals are found; goals that are walled off are never found.\n",
    "    Each goal is reported in the iteration in which its depth is first\n",
    "    within the limit, so the goals come out nearest first.\n",
    "\n",
    "    Memory note: to keep the running time acceptable on open maps, each\n",
    "    iteration remembers the best depth of every cell it reached. That is\n",
    "    more than the textbook IDDFS stores, but it is what makes the search\n",
    "    feasible on grids with many equivalent paths.\n",
    "\n",
    "    The search tree of the last (complete) iteration is drawn into\n",
    "    ``maze_map`` with ``assign_character``, so after the call ``maze_map``\n",
    "    is the fully explored map. Pass a fresh copy of a map from\n",
    "    ``load_map``; a map that already contains drawn paths is not a valid\n",
    "    input.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    maze_map : List[List[str]]\n",
    "        The maze as returned by ``load_map`` (``maze_map[row][col]``).\n",
    "        It is modified in place, see above.\n",
    "    monitor : bool\n",
    "        If True, print every goal found and one line per iteration (depth\n",
    "        limit, number of cells reached, new goals), plus a summary. There\n",
    "        is no line per node, because the same nodes are visited in many\n",
    "        iterations. Defaults to False: no output.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    List[Node]\n",
    "        The goal nodes in the order they were found, nearest goal first\n",
    "        (empty if no goal is reachable). ``node.path()`` gives the nodes\n",
    "        from the start to that goal and ``node.depth`` the path length.\n",
    "\n",
    "    Raises\n",
    "    ------\n",
    "    ValueError\n",
    "        If the map contains no start position.\n",
    "    \"\"\"\n",
    "    graph = mazemaptotree(maze_map)\n",
    "    start_node = Node(find_start(maze_map))\n",
    "    goal_nodes: List[Node] = []\n",
    "    found: Set[Position] = set()\n",
    "    limit = 0\n",
    "\n",
    "    while True:\n",
    "        best, order = depth_limited_search(graph, start_node, limit)\n",
    "\n",
    "        new_goals = 0\n",
    "        for node in order:\n",
    "            pos = node.position\n",
    "            if maze_map[pos[0]][pos[1]] == GOAL and pos not in found:\n",
    "                found.add(pos)\n",
    "                goal_nodes.append(best[pos])\n",
    "                new_goals += 1\n",
    "                if monitor:\n",
    "                    print(f\"goal #{len(goal_nodes)} found at {pos}, \"\n",
    "                          f\"path length {best[pos].depth}\")\n",
    "        if monitor:\n",
    "            print(f\"limit={limit}: {len(best)} cells reached, {new_goals} new goal(s)\")\n",
    "\n",
    "        # Cut off = a cell at the limit still has an unreached neighbour.\n",
    "        cut_off = any(nd.depth == limit and any(nb not in best for nb in graph[pos])\n",
    "                      for pos, nd in best.items())\n",
    "        if not cut_off:\n",
    "            break                                   # the whole reachable map is explored\n",
    "        limit += 1\n",
    "\n",
    "    for pos, node in best.items():                  # draw the tree of the last iteration\n",
    "        if node.parent is not None:\n",
    "            assign_character(maze_map, pos, node.parent.position)\n",
    "\n",
    "    if monitor:\n",
    "        print(f\"done: {limit + 1} iterations, {len(goal_nodes)} goal(s) found\")\n",
    "    return goal_nodes"
   ]
