    "import tempfile, os\n",
    "\n",
    "def _write_tmp(text: str) -> str:\n",
    "    fd, p = tempfile.mkstemp(suffix=\".txt\")\n",
    "    with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n",
    "        f.write(text)\n",
    "    return p\n",
    "\n",
    "# --- small hand-made map -------------------------------------------------\n",
    "tiny = \"#####\\n#s *#\\n# # #\\n#   #\\n#####\"\n",
    "p = _write_tmp(tiny)\n",
    "grid, start, goals = load_map(p)\n",
    "\n",
    "assert start == (1, 1)                       # 's' is found\n",
    "assert grid[1][1] == \"S\"                     # and normalised to 'S'\n",
    "assert goals == {(1, 3)}                     # '*' collected\n",
    "assert all(len(r) == len(grid[0]) for r in grid)   # rectangular grid\n",
    "\n",
    "graph = mazemaptotree(grid)\n",
    "assert (0, 0) not in graph                   # obstacles are not nodes\n",
    "assert set(graph[(1, 1)]) == {(1, 2), (2, 1)}        # right and down only\n",
    "assert set(graph[(1, 3)]) == {(1, 2), (2, 3)}\n",
    "# moves are symmetric: if a -> b then b -> a\n",
    "assert all(a in graph[b] for a in graph for b in graph[a])\n",
    "\n",
    "# --- ragged rows get padded, missing start raises -------------------------\n",
    "g, s, _ = load_map(_write_tmp(\"####\\n#s*\\n####\"))\n",
    "assert all(len(r) == 4 for r in g)\n",
    "try:\n",
    "    load_map(_write_tmp(\"###\\n# #\\n###\"))\n",
    "    raise AssertionError(\"expected ValueError\")\n",
    "except ValueError:\n",
    "    pass\n",
    "\n",
    "# --- the real maps ---------------------------------------------------------\n",
    "expected = {\"map1\": ((1, 3), 4), \"map2\": ((1, 4), 10)}\n",
    "for name in (\"map1\", \"map2\", \"map3\"):\n",
    "    grid, start, goals = load_map(f\"./data/{name}.txt\")\n",
    "    graph = mazemaptotree(grid)\n",
    "    assert start in graph and goals <= set(graph)\n",
    "    assert grid[start[0]][start[1]] == \"S\"\n",
    "    if name in expected:\n",
    "        assert (start, len(goals)) == expected[name], name\n",
    "   \n",
    "print(\"All tests passed.\")"
   ]
