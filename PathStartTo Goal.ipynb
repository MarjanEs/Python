    "from pathlib import Path\n",
    "from typing import Dict, List, Set, Tuple\n",
    "\n",
    "Position = Tuple[int, int]            # (row, col)\n",
    "Grid = List[List[str]]\n",
    "Graph = Dict[Position, List[Position]]\n",
    "\n",
    "GOAL = \"*\"\n",
    "FREE = \" \"\n",
    "START = \"S\"                           # normalised start symbol in the grid\n",
    "START_CHARS = {\"S\", \"s\"}              # the maps use lowercase 's'\n",
    "OBSTACLE = \"#\"                        # used only for padding short rows\n",
    "\n",
    "\n",
    "def load_map(path: str | Path) -> Tuple[Grid, Position, Set[Position]]:\n",
    "    \"\"\"Load a maze map from a text file into memory.\n",
    "\n",
    "    Every character in the file is one grid cell: ``*`` is a goal, a space\n",
    "    is free, ``s``/``S`` is the start position and any other character\n",
    "    (e.g. ``=`` and ``|``) is an obstacle. Rows shorter than the longest\n",
    "    row are padded with obstacles, so the grid is always rectangular. The\n",
    "    start cell is stored as ``\"S\"`` in the returned grid.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    path : str or Path\n",
    "        Path to the .txt map file, e.g. ``\"./data/map1.txt\"``.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    grid : List[List[str]]\n",
    "        The map as a list of rows, each row a list of characters,\n",
    "        indexed as ``grid[row][col]``.\n",
    "    start : Tuple[int, int]\n",
    "        ``(row, col)`` of the agent's initial position.\n",
    "    goals : Set[Tuple[int, int]]\n",
    "        ``(row, col)`` of every goal cell ``*`` (the maps contain several).\n",
    "\n",
    "    Raises\n",
    "    ------\n",
    "    ValueError\n",
    "        If the map contains no start position.\n",
    "    \"\"\"\n",
    "    # Only strip line breaks: spaces are meaningful (free cells).\n",
    "    with open(path, encoding=\"utf-8\") as f:\n",
    "        lines = [line.rstrip(\"\\r\\n\") for line in f]\n",
    "\n",
    "    width = max((len(line) for line in lines), default=0)\n",
    "    grid: Grid = [list(line.ljust(width, OBSTACLE)) for line in lines]\n",
    "\n",
    "    start: Position | None = None\n",
    "    goals: Set[Position] = set()\n",
    "    for r, row in enumerate(grid):\n",
    "        for c, cell in enumerate(row):\n",
    "            if cell in START_CHARS:\n",
    "                start = (r, c)\n",
    "                grid[r][c] = START\n",
    "            elif cell == GOAL:\n",
    "                goals.add((r, c))\n",
    "\n",
    "    if start is None:\n",
    "        raise ValueError(f\"No start position 's' found in {path}\")\n",
    "    return grid, start, goals\n",
    "\n",
    "\n",
    "def mazemaptotree(maze_map: Grid) -> Graph:\n",
    "    \"\"\"Create a search structure from the map.\n",
    "\n",
    "    For every walkable cell (free, start or goal) the possible movements\n",
    "    (up, right, down, left) are checked. A move is possible if the target\n",
    "    cell lies inside the grid and is not an obstacle. The result is an\n",
    "    adjacency dictionary, so a search algorithm can look up the successors\n",
    "    of any position. The neighbour order is fixed, which makes\n",
    "    BFS/DFS/IDDFS results reproducible.\n",
    "\n",
    "    Note: since a cell can be reached from several neighbours this is\n",
    "    technically a graph; the search needs a visited set (or a path-based\n",
    "    cycle check) to explore it as a tree.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    maze_map : List[List[str]]\n",
    "        Grid as returned by :func:`load_map`, indexed as ``maze_map[row][col]``.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    Dict[Tuple[int, int], List[Tuple[int, int]]]\n",
    "        Maps each walkable ``(row, col)`` position to the list of positions\n",
    "        reachable from it in one step. Obstacles are not keys.\n",
    "    \"\"\"\n",
    "    walkable = {FREE, START, GOAL}\n",
    "    moves = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up, right, down, left\n",
    "\n",
    "    graph: Graph = {}\n",
    "    for r, row in enumerate(maze_map):\n",
    "        for c, cell in enumerate(row):\n",
    "            if cell not in walkable:\n",
    "                continue\n",
    "            neighbours: List[Position] = []\n",
    "            for dr, dc in moves:\n",
    "                nr, nc = r + dr, c + dc\n",
    "                if 0 <= nr < len(maze_map) and 0 <= nc < len(maze_map[nr]):\n",
    "                    if maze_map[nr][nc] in walkable:\n",
    "                        neighbours.append((nr, nc))\n",
    "            graph[(r, c)] = neighbours\n",
    "    return graph\n",
    "\n",
    "for name in (\"map1\", \"map2\", \"map3\"):\n",
    "    grid, start, goals = load_map(f\"./data/{name}.txt\")\n",
    "    graph = mazemaptotree(grid)\n",
    "    print(name, \"start:\", start, \"goals:\", len(goals), \"walkable cells:\", len(graph))    "
   ]
  },
