   "source": [
    "from typing import Callable, List, Set\n",
    "\n",
    "# Node, find_start, mazemaptotree, assign_character, write_to_file, load_map\n",
    "# and Position / Grid / GOAL come from the code above.\n",
    "\n",
    "\n",
    "def depthfirstsearch(maze_map: Grid, monitor: bool = False) -> List[Node]:\n",
    "    \"\"\"Depth-first search (DFS) on the maze.\n",
    "\n",
    "    The key point of DFS is that the frontier is a stack with last-in,\n",
    "    first-out (LIFO) behaviour: the agent always expands the newest node\n",
    "    first, so it follows one corridor as deep as possible and only turns\n",
    "    back when it hits a wall or an already visited cell. The neighbours are\n",
    "    tried in the order up, right, down, left.\n",
    "\n",
    "    A node is marked as visited when it is taken from the stack, not when\n",
    "    it is put on it. Only then is the search tree a real depth-first tree:\n",
    "    a cell stays on the stack until the deeper branch has finished, and it\n",
    "    is reached from the branch that got there first.\n",
    "\n",
    "    The agent does not know where the goals are. It only recognises a goal\n",
    "    when it reaches a ``*`` cell, and it keeps exploring afterwards until\n",
    "    the whole reachable map is explored, so all reachable goals are found.\n",
    "    Goals that are walled off are never found. Unlike BFS, the path to a\n",
    "    goal is generally **not** a shortest one (on your maps it is up to\n",
    "    about 10 times longer).\n",
    "\n",
    "    While searching, every move of the search tree is drawn into\n",
    "    ``maze_map`` with ``assign_character``. After the call, ``maze_map``\n",
    "    is therefore the fully explored map. Pass a fresh copy of a map from\n",
    "    ``load_map``; a map that already contains drawn paths is not a valid\n",
    "    input.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    maze_map : List[List[str]]\n",
    "        The maze as returned by ``load_map`` (``maze_map[row][col]``).\n",
    "        It is modified in place, see above.\n",
    "    monitor : bool\n",
    "        If True, print every expanded node, every goal found and a summary\n",
    "        to the command line. Defaults to False: no output.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    List[Node]\n",
    "        The goal nodes in the order they were found (empty if no goal is\n",
    "        reachable). ``node.path()`` gives the nodes from the start to that\n",
    "        goal and ``node.depth`` the path length.\n",
    "\n",
    "    Raises\n",
    "    ------\n",
    "    ValueError\n",
    "        If the map contains no start position.\n",
    "    \"\"\"\n",
    "    graph = mazemaptotree(maze_map)\n",
    "    stack: List[Node] = [Node(find_start(maze_map))]    # LIFO frontier\n",
    "    visited: Set[Position] = set()\n",
    "    goal_nodes: List[Node] = []\n",
    "    expanded = 0\n",
    "\n",
    "    while stack:\n",
    "        node = stack.pop()\n",
    "        if node.position in visited:                    # reached earlier via another branch\n",
    "            continue\n",
    "        visited.add(node.position)\n",
    "        expanded += 1\n",
    "        if node.parent is not None:\n",
    "            assign_character(maze_map, node.position, node.parent.position)\n",
    "        if monitor:\n",
    "            print(f\"expand {node.position} depth={node.depth} frontier={len(stack)}\")\n",
    "        if maze_map[node.position[0]][node.position[1]] == GOAL:\n",
    "            goal_nodes.append(node)\n",
    "            if monitor:\n",
    "                print(f\"goal #{len(goal_nodes)} found at {node.position}, \"\n",
    "                      f\"path length {node.depth}\")\n",
    "        # push in reverse so that the first neighbour (up) is expanded first\n",
    "        for child_pos in reversed(graph[node.position]):\n",
    "            if child_pos not in visited:\n",
    "                stack.append(Node(child_pos, node, node.depth + 1))\n",
    "\n",
    "    if monitor:\n",
    "        print(f\"done: {expanded} nodes expanded, {len(goal_nodes)} goal(s) found\")\n",
    "    return goal_nodes\n",
    "\n",
    "\n",
    "\n",
    "def run_search_on_maps(search: Callable[[Grid], List[Node]], prefix: str,\n",
    "                       data_dir: str = \"./data\",\n",
    "                       results_dir: str = \"./data/results\") -> None:\n",
    "    \"\"\"Run ``search`` on every ``map*.txt`` in ``data_dir`` and save the results.\n",
    "\n",
    "    Per map ``mapN`` this writes ``<prefix>_mapN.txt`` (the fully explored map)\n",
    "    and ``<prefix>_mapN_goal<k>.txt`` (the path to the k-th goal found) to\n",
    "    ``results_dir``. ``search`` takes a map from ``load_map`` and returns the\n",
    "    goal nodes, like ``breadthfirstsearch`` and ``depthfirstsearch``.\n",
    "    \"\"\"\n",
    "    for map_file in sorted(Path(data_dir).glob(\"map*.txt\")):\n",
    "        grid, start, goals = load_map(map_file)\n",
    "        explored = [row[:] for row in grid]\n",
    "        goal_nodes = search(explored)\n",
    "        stem = f\"{prefix}_{map_file.stem}\"\n",
    "        write_to_file(Path(results_dir) / f\"{stem}.txt\", explored)\n",
    "        for i, goal in enumerate(goal_nodes, start=1):\n",
    "            path_map = [row[:] for row in grid]\n",
    "            nodes = goal.path()\n",
    "            for prev, cur in zip(nodes, nodes[1:]):\n",
    "                assign_character(path_map, cur.position, prev.position)\n",
    "            write_to_file(Path(results_dir) / f\"{stem}_goal{i}.txt\", path_map)\n",
    "        print(f\"{map_file.name}: found {len(goal_nodes)} of {len(goals)} goals\")\n",
    "\n",
    "run_search_on_maps(depthfirstsearch, \"dfs\")    "
   ]
