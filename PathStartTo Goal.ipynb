    "import contextlib\n",
    "import io\n",
    "import tempfile\n",
    "from collections import deque\n",
    "from pathlib import Path\n",
    "\n",
    "# --- tiny maps -------------------------------------------------------------\n",
    "room = [list(r) for r in [\"#####\",\n",
    "                          \"#   #\",\n",
    "                          \"# S*#\",\n",
    "                          \"#   #\",\n",
    "                          \"#####\"]]\n",
    "found = iterative_deepening_depth_first_search(room)\n",
    "assert len(found) == 1 and found[0].depth == 1       # shortest path, unlike DFS\n",
    "assert [n.position for n in found[0].path()] == [(2, 2), (2, 3)]\n",
    "assert room[2][2] == \"S\" and room[2][3] == \"*\"       # markers are kept\n",
    "assert room[1][2] in CHAR_TO_LINKS                   # explored cells are drawn\n",
    "\n",
    "# shortest path is chosen even if a longer way exists\n",
    "loop = [list(r) for r in [\"#######\",\n",
    "                          \"#S   *#\",\n",
    "                          \"# ### #\",\n",
    "                          \"#     #\",\n",
    "                          \"#######\"]]\n",
    "assert iterative_deepening_depth_first_search(loop)[0].depth == 4\n",
    "\n",
    "# goals come out nearest first\n",
    "two = [list(r) for r in [\"#########\",\n",
    "                         \"#*  S  *#\",\n",
    "                         \"#########\"]]\n",
    "assert [n.depth for n in iterative_deepening_depth_first_search(two)] == [3, 3]\n",
    "uneven = [list(r) for r in [\"##########\",\n",
    "                            \"#*  S   *#\",\n",
    "                            \"##########\"]]\n",
    "assert [n.depth for n in iterative_deepening_depth_first_search(uneven)] == [3, 4]\n",
    "\n",
    "# --- no reachable goal / isolated start / no start / monitor ----------------\n",
    "assert iterative_deepening_depth_first_search([list(r) for r in [\"####\", \"#S #\", \"####\"]]) == []\n",
    "assert iterative_deepening_depth_first_search([list(r) for r in [\"###\", \"#S#\", \"###\"]]) == []\n",
    "try:\n",
    "    iterative_deepening_depth_first_search([list(\"# #\")])\n",
    "    raise AssertionError(\"expected ValueError\")\n",
    "except ValueError:\n",
    "    pass\n",
    "buf = io.StringIO()\n",
    "with contextlib.redirect_stdout(buf):\n",
    "    iterative_deepening_depth_first_search([list(r) for r in [\"####\", \"#S*#\", \"####\"]])\n",
    "assert buf.getvalue() == \"\"                           # silent by default\n",
    "with contextlib.redirect_stdout(buf):\n",
    "    iterative_deepening_depth_first_search([list(r) for r in [\"####\", \"#S*#\", \"####\"]], monitor=True)\n",
    "assert \"goal #1\" in buf.getvalue() and \"limit=\" in buf.getvalue()\n",
    "\n",
    "# --- real maps: compare with BFS ---------------------------------------------\n",
    "expected_depths = {\n",
    "    \"map1\": [31, 62, 63, 87],\n",
    "    \"map2\": [38, 68, 88, 94, 98, 108, 108, 116, 121, 134],\n",
    "    \"map3\": [14, 22, 32, 45, 46, 48, 59, 63, 71, 74, 79, 89],\n",
    "}\n",
    "for name in (\"map1\", \"map2\", \"map3\"):\n",
    "    grid, start, goals = load_map(f\"./data/{name}.txt\")\n",
    "    pristine = [r[:] for r in grid]\n",
    "    found = iterative_deepening_depth_first_search(grid)\n",
    "    bfs = breadthfirstsearch([r[:] for r in pristine])\n",
    "    bfs_depth = {n.position: n.depth for n in bfs}\n",
    "\n",
    "    assert [n.depth for n in found] == expected_depths[name], name\n",
    "    assert [n.depth for n in found] == [n.depth for n in bfs], name\n",
    "    assert {n.position for n in found} == set(bfs_depth), name   # same goals as BFS\n",
    "    for n in found:\n",
    "        assert n.depth == bfs_depth[n.position]                  # shortest path\n",
    "        p = n.path()\n",
    "        assert p[0].position == start and p[-1] is n and len(p) == n.depth + 1\n",
    "        assert all(abs(a.position[0] - b.position[0]) + abs(a.position[1] - b.position[1]) == 1\n",
    "                   for a, b in zip(p, p[1:]))\n",
    "        assert all(pristine[x.position[0]][x.position[1]] in \" S*\" for x in p)\n",
    "\n",
    "    # every reachable free cell is drawn, and drawn links are symmetric\n",
    "    graph = mazemaptotree(pristine)\n",
    "    reach, q = {start}, deque([start])\n",
    "    while q:\n",
    "        for m in graph[q.popleft()]:\n",
    "            if m not in reach:\n",
    "                reach.add(m)\n",
    "                q.append(m)\n",
    "    assert all(grid[r][c] in CHAR_TO_LINKS for (r, c) in reach if pristine[r][c] == \" \"), name\n",
    "    for (r, c) in reach:\n",
    "        if grid[r][c] not in CHAR_TO_LINKS:\n",
    "            continue\n",
    "        for (dr, dc), bit in STEP_TO_LINK.items():\n",
    "            if CHAR_TO_LINKS[grid[r][c]] & bit:\n",
    "                other = grid[r + dr][c + dc]\n",
    "                assert (CHAR_TO_LINKS[other] & OPPOSITE[bit]) if other in CHAR_TO_LINKS \\\n",
    "                    else other in \"S*\", (name, (r, c))\n",
    "\n",
    "# --- saving the results (into a temporary folder) -------------------------------\n",
    "out = Path(tempfile.mkdtemp()) / \"results\"\n",
    "run_search_on_maps(iterative_deepening_depth_first_search, \"iddfs\", \"./data\", str(out))\n",
    "files = sorted(p.name for p in out.iterdir())\n",
    "assert \"iddfs_map1.txt\" in files and \"iddfs_map3_goal12.txt\" in files\n",
    "assert \"iddfs_map3_goal13.txt\" not in files\n",
    "assert len(files) == 3 + 4 + 10 + 12\n",
    "assert (out / \"iddfs_map1.txt\").read_text(encoding=\"utf-8\").count(\"S\") == 1\n",
    "\n",
    "print(\"All tests passed.\")"
   ]
