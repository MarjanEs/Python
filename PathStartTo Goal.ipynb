    "from pathlib import Path\n",
    "from typing import Dict, List, Optional\n",
    "\n",
    "# Position, Grid and FREE come from the parsing code above.\n",
    "\n",
    "# One bit per direction in which a cell is connected to a neighbouring cell.\n",
    "UP, RIGHT, DOWN, LEFT = 1, 2, 4, 8\n",
    "\n",
    "# Set of connections -> box-drawing character.\n",
    "LINKS_TO_CHAR: Dict[int, str] = {\n",
    "    LEFT: \"\\u2574\",                       # ╴\n",
    "    UP: \"\\u2575\",                         # ╵\n",
    "    RIGHT: \"\\u2576\",                      # ╶\n",
    "    DOWN: \"\\u2577\",                       # ╷\n",
    "    LEFT | RIGHT: \"\\u2500\",               # ─\n",
    "    UP | DOWN: \"\\u2502\",                  # │\n",
    "    DOWN | RIGHT: \"\\u250c\",               # ┌\n",
    "    DOWN | LEFT: \"\\u2510\",                # ┐\n",
    "    UP | RIGHT: \"\\u2514\",                 # └\n",
    "    UP | LEFT: \"\\u2518\",                  # ┘\n",
    "    UP | DOWN | RIGHT: \"\\u251c\",          # ├\n",
    "    UP | DOWN | LEFT: \"\\u2524\",           # ┤\n",
    "    LEFT | RIGHT | DOWN: \"\\u252c\",        # ┬\n",
    "    LEFT | RIGHT | UP: \"\\u2534\",          # ┴\n",
    "    UP | DOWN | LEFT | RIGHT: \"\\u253c\",   # ┼\n",
    "}\n",
    "CHAR_TO_LINKS: Dict[str, int] = {ch: links for links, ch in LINKS_TO_CHAR.items()}\n",
    "\n",
    "STEP_TO_LINK: Dict[Position, int] = {(-1, 0): UP, (0, 1): RIGHT, (1, 0): DOWN, (0, -1): LEFT}\n",
    "OPPOSITE: Dict[int, int] = {UP: DOWN, DOWN: UP, LEFT: RIGHT, RIGHT: LEFT}\n",
    "\n",
    "\n",
    "def assign_character(maze_map: Grid, current_node: Position,\n",
    "                     prev_node: Optional[Position]) -> Grid:\n",
    "    \"\"\"Draw the move ``prev_node -> current_node`` into the map.\n",
    "\n",
    "    Every cell of the map remembers in which directions it is connected to\n",
    "    its neighbours, and shows this as a box-drawing character. A move\n",
    "    adds one connection to each of the two cells: ``prev_node`` gets a\n",
    "    connection towards ``current_node`` and ``current_node`` gets one back\n",
    "    towards ``prev_node``. Connections already drawn are kept, so a cell\n",
    "    that is the parent of several nodes becomes a junction.\n",
    "\n",
    "    Examples: a cell reached from the left and left again to the right\n",
    "    shows ``─``; a dead end entered from above shows ``╵``; a cell that\n",
    "    has a parent above and children below, left and right shows ``┼``.\n",
    "\n",
    "    Call it once for every edge of the search tree, i.e. for each node\n",
    "    that is generated/visited together with the node it came from.\n",
    "    Backtracking is not an edge and is not drawn.\n",
    "\n",
    "    Cells that are not free are never changed: the start ``S``, goals\n",
    "    ``*`` and obstacles keep their character.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    maze_map : List[List[str]]\n",
    "        Grid as returned by ``load_map``, indexed ``maze_map[row][col]``.\n",
    "        It is modified in place.\n",
    "    current_node : Tuple[int, int]\n",
    "        ``(row, col)`` of the node the agent moves to.\n",
    "    prev_node : Tuple[int, int] or None\n",
    "        ``(row, col)`` of the node the agent moves from (the parent of\n",
    "        ``current_node``). ``None`` for the start node, in which case the\n",
    "        map is not changed.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    List[List[str]]\n",
    "        The same ``maze_map`` object, after the update.\n",
    "\n",
    "    Raises\n",
    "    ------\n",
    "    ValueError\n",
    "        If the two nodes are not direct neighbours (up, down, left or\n",
    "        right) or if one of them lies outside the map.\n",
    "    \"\"\"\n",
    "    if prev_node is None:\n",
    "        return maze_map\n",
    "    step = (current_node[0] - prev_node[0], current_node[1] - prev_node[1])\n",
    "    if step not in STEP_TO_LINK:\n",
    "        raise ValueError(f\"{prev_node} -> {current_node} is not a single step\")\n",
    "    for r, c in (prev_node, current_node):\n",
    "        if not (0 <= r < len(maze_map) and 0 <= c < len(maze_map[r])):\n",
    "            raise ValueError(f\"node {(r, c)} lies outside the map\")\n",
    "\n",
    "    link = STEP_TO_LINK[step]\n",
    "    for (r, c), bit in ((prev_node, link), (current_node, OPPOSITE[link])):\n",
    "        cell = maze_map[r][c]\n",
    "        if cell == FREE or cell in CHAR_TO_LINKS:   # free or already drawn\n",
    "            maze_map[r][c] = LINKS_TO_CHAR[CHAR_TO_LINKS.get(cell, 0) | bit]\n",
    "    return maze_map"
   ]
  },
