    "from collections import deque\n",
    "from dataclasses import dataclass\n",
    "from pathlib import Path\n",
    "from typing import List, Optional, Set\n",
    "\n",
    "# Position, Grid, START, GOAL, mazemaptotree, assign_character and\n",
    "# write_to_file come from the code above.\n",
    "\n",
    "\n",
    "@dataclass(eq=False)\n",
    "class Node:\n",
    "    \"\"\"A node of the search tree.\n",
    "\n",
    "    Attributes\n",
    "    ----------\n",
    "    position : Tuple[int, int]\n",
    "        ``(row, col)`` of the cell this node stands for.\n",
    "    parent : Node or None\n",
    "        The node this one was reached from (``None`` for the start).\n",
    "    depth : int\n",
    "        Number of steps from the start, i.e. the path length.\n",
    "    \"\"\"\n",
    "    position: Position\n",
    "    parent: Optional[\"Node\"] = None\n",
    "    depth: int = 0\n",
    "\n",
    "    def path(self) -> List[\"Node\"]:\n",
    "        \"\"\"Return the nodes from the start to this node, both included.\"\"\"\n",
    "        nodes: List[\"Node\"] = []\n",
    "        node: Optional[\"Node\"] = self\n",
    "        while node is not None:\n",
    "            nodes.append(node)\n",
    "            node = node.parent\n",
    "        nodes.reverse()\n",
    "        return nodes\n",
    "\n",
    "\n",
    "def find_start(maze_map: Grid) -> Position:\n",
    "    \"\"\"Return the ``(row, col)`` of the start cell ``S`` in a map from ``load_map``.\"\"\"\n",
    "    for r, row in enumerate(maze_map):\n",
    "        for c, cell in enumerate(row):\n",
    "            if cell == START:\n",
    "                return (r, c)\n",
    "    raise ValueError(\"The map contains no start position 'S'.\")\n",
    "\n",
    "\n",
    "def breadthfirstsearch(maze_map: Grid, monitor: bool = False) -> List[Node]:\n",
    "    \"\"\"Breadth-first search (BFS) on the maze.\n",
    "\n",
    "    The key point of BFS is that the frontier is a queue with first-in,\n",
    "    first-out (FIFO) behaviour: the agent always expands the oldest node\n",
    "    first, so it explores the map in rings of growing distance from the\n",
    "    start. The path found to each goal is therefore a shortest one.\n",
    "\n",
    "    The agent does not know where the goals are. It only recognises a goal\n",
    "    when it reaches a ``*`` cell, and it keeps exploring afterwards until\n",
    "    the whole reachable map is explored, so the paths to all reachable\n",
    "    goals are found. Goals that are walled off are never found.\n",
    "\n",
    "    While searching, every move of the search tree is drawn into\n",
    "    ``maze_map`` with ``assign_character``. After the call, ``maze_map``\n",
    "    is therefore the fully explored map. Pass a fresh copy of a map from\n",
    "    ``load_map``; a map that already contains drawn paths is not a valid\n",
    "    input.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    maze_map : List[List[str]]\n",
    "        The maze as returned by ``load_map`` (``maze_map[row][col]``).\n",
    "        It is modified in place, see above.\n",
    "    monitor : bool\n",
    "        If True, print every expanded node, every goal found and a summary\n",
    "        to the command line. Defaults to False: no output.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    List[Node]\n",
    "        The goal nodes in the order they were found, nearest goal first\n",
    "        (empty if no goal is reachable). ``node.path()`` gives the nodes\n",
    "        from the start to that goal and ``node.depth`` the path length.\n",
    "\n",
    "    Raises\n",
    "    ------\n",
    "    ValueError\n",
    "        If the map contains no start position.\n",
    "    \"\"\"\n",
    "    graph = mazemaptotree(maze_map)\n",
    "    start_node = Node(find_start(maze_map))\n",
    "    queue: deque = deque([start_node])          # FIFO frontier\n",
    "    visited: Set[Position] = {start_node.position}\n",
    "    goal_nodes: List[Node] = []\n",
    "    expanded = 0\n",
    "\n",
    "    while queue:\n",
    "        node = queue.popleft()\n",
    "        expanded += 1\n",
    "        if monitor:\n",
    "            print(f\"expand {node.position} depth={node.depth} frontier={len(queue)}\")\n",
    "        for child_pos in graph[node.position]:\n",
    "            if child_pos in visited:\n",
    "                continue\n",
    "            visited.add(child_pos)\n",
    "            child = Node(child_pos, node, node.depth + 1)\n",
    "            assign_character(maze_map, child_pos, node.position)\n",
    "            queue.append(child)\n",
    "            if maze_map[child_pos[0]][child_pos[1]] == GOAL:\n",
    "                goal_nodes.append(child)\n",
    "                if monitor:\n",
    "                    print(f\"goal #{len(goal_nodes)} found at {child_pos}, \"\n",
    "                          f\"path length {child.depth}\")\n",
    "\n",
    "    if monitor:\n",
    "        print(f\"done: {expanded} nodes expanded, {len(goal_nodes)} goal(s) found\")\n",
    "    return goal_nodes\n",
    "\n",
    "\n",
    "def run_bfs_on_maps(data_dir: str = \"./data\", results_dir: str = \"./data/results\") -> None:\n",
    "    \"\"\"Run BFS on every ``map*.txt`` in ``data_dir`` and save the results.\n",
    "\n",
    "    Per map ``mapN`` this writes ``bfs_mapN.txt`` (the fully explored map) and\n",
    "    ``bfs_mapN_goal<k>.txt`` (the shortest path to the k-th goal found) to\n",
    "    ``results_dir``.\n",
    "    \"\"\"\n",
    "    for map_file in sorted(Path(data_dir).glob(\"map*.txt\")):\n",
    "        grid, start, goals = load_map(map_file)\n",
    "        explored = [row[:] for row in grid]\n",
    "        goal_nodes = breadthfirstsearch(explored)\n",
    "        stem = f\"bfs_{map_file.stem}\"\n",
    "        write_to_file(Path(results_dir) / f\"{stem}.txt\", explored)\n",
    "        for i, goal in enumerate(goal_nodes, start=1):\n",
    "            path_map = [row[:] for row in grid]\n",
    "            nodes = goal.path()\n",
    "            for prev, cur in zip(nodes, nodes[1:]):\n",
    "                assign_character(path_map, cur.position, prev.position)\n",
    "            write_to_file(Path(results_dir) / f\"{stem}_goal{i}.txt\", path_map)\n",
    "        print(f\"{map_file.name}: found {len(goal_nodes)} of {len(goals)} goals\")\n",
    "\n",
    "run_bfs_on_maps()    "
   ]
