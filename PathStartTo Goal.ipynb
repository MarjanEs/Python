    "with open(f, encoding=\"utf-8\") as fh:\n",
    "    assert fh.read() == \"ab\\ncd\\n\"\n",
    "\n",
    "# --- end to end on the real maps (BFS) -------------------------------------\n",
    "for name in (\"map1\", \"map2\", \"map3\"):\n",
    "    grid, start, goals = load_map(f\"./data/{name}.txt\")\n",
    "    graph = mazemaptotree(grid)\n",
    "    came_from, explored, q = {start: None}, [r[:] for r in grid], deque([start])\n",
    "    while q:\n",
    "        n = q.popleft()\n",
    "        for k in graph[n]:\n",
    "            if k not in came_from:\n",
    "                came_from[k] = n\n",
    "                assign_character(explored, k, n)\n",
    "                q.append(k)\n",
    "    free = [p for p in came_from if grid[p[0]][p[1]] == FREE]\n",
    "    assert all(explored[r][c] in CHAR_TO_LINKS for r, c in free), name\n",
    "    assert explored[start[0]][start[1]] == \"S\"\n",
    "    out = os.path.join(d, f\"{name}.txt\")\n",
    "    write_to_file(out, explored)\n",
    "    with open(out, encoding=\"utf-8\") as fh:\n",
    "        lines = fh.read().splitlines()\n",
    "    assert len(lines) == len(grid) and all(len(l) == len(grid[0]) for l in lines)\n",
    "\n",
    "print(\"All tests passed.\")"
