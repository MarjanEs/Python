    "import contextlib\n",
    "import io\n",
    "import sys\n",
    "import tempfile\n",
    "from pathlib import Path\n",
    "\n",
    "# --- tiny map: DFS takes the first neighbour (up, right, down, left) -------\n",
    "# Start in an open room: DFS goes up first, so it reaches the goal the long way.\n",
    "room = [list(r) for r in [\"#####\",\n",
    "                          \"#   #\",\n",
    "                          \"# S*#\",\n",
    "                          \"#   #\",\n",
    "                          \"#####\"]]\n",
    "found = depthfirstsearch(room)\n",
    "assert len(found) == 1\n",
    "assert [n.position for n in found[0].path()] == [(2, 2), (1, 2), (1, 3), (2, 3)]\n",
    "assert found[0].depth == 3                          # BFS would find it in 1 step\n",
    "assert breadthfirstsearch([list(r) for r in [\"#####\", \"#   #\", \"# S*#\", \"#   #\", \"#####\"]])[0].depth == 1\n",
    "assert room[2][2] == \"S\" and room[2][3] == \"*\"      # markers are kept\n",
    "assert room[1][2] in CHAR_TO_LINKS                  # path was drawn\n",
    "\n",
    "# --- no reachable goal / no start / monitor ---------------------------------\n",
    "assert depthfirstsearch([list(r) for r in [\"####\", \"#S #\", \"####\"]]) == []\n",
    "try:\n",
    "    depthfirstsearch([list(\"# #\")])\n",
    "    raise AssertionError(\"expected ValueError\")\n",
    "except ValueError:\n",
    "    pass\n",
    "buf = io.StringIO()\n",
    "with contextlib.redirect_stdout(buf):\n",
    "    depthfirstsearch([list(r) for r in [\"####\", \"#S*#\", \"####\"]])\n",
    "assert buf.getvalue() == \"\"                          # silent by default\n",
    "with contextlib.redirect_stdout(buf):\n",
    "    depthfirstsearch([list(r) for r in [\"####\", \"#S*#\", \"####\"]], monitor=True)\n",
    "assert \"goal #1\" in buf.getvalue()\n",
    "\n",
    "# --- real maps: compare with a recursive reference DFS (same neighbour order)\n",
    "sys.setrecursionlimit(20000)\n",
    "\n",
    "def reference_dfs(graph, start):\n",
    "    parent, order = {start: None}, []\n",
    "    def visit(p):\n",
    "        order.append(p)\n",
    "        for q in graph[p]:\n",
    "            if q not in parent:\n",
    "                parent[q] = p\n",
    "                visit(q)\n",
    "    visit(start)\n",
    "    return parent, order\n",
    "\n",
    "expected_depths = {\n",
    "    \"map1\": [93, 519, 709, 660],\n",
    "    \"map2\": [288, 362, 546, 612, 666, 788, 835, 850, 878, 252],\n",
    "    \"map3\": [79, 129, 448, 620, 1162, 1248, 1516, 1703, 1857, 1615, 1466, 913],\n",
    "}\n",
    "for name in (\"map1\", \"map2\", \"map3\"):\n",
    "    grid, start, goals = load_map(f\"./data/{name}.txt\")\n",
    "    pristine = [r[:] for r in grid]\n",
    "    graph = mazemaptotree(pristine)\n",
    "    parent, order = reference_dfs(graph, start)\n",
    "    found = depthfirstsearch(grid)\n",
    "\n",
    "    ref_goals = [p for p in order if pristine[p[0]][p[1]] == \"*\"]\n",
    "    assert [n.position for n in found] == ref_goals, name       # same goals, same order\n",
    "    assert [n.depth for n in found] == expected_depths[name], name\n",
    "    for n in found:\n",
    "        ref_path, pos = [], n.position\n",
    "        while pos is not None:\n",
    "            ref_path.append(pos)\n",
    "            pos = parent[pos]\n",
    "        assert [x.position for x in n.path()] == ref_path[::-1], name\n",
    "    # every reachable free cell was explored and drawn\n",
    "    assert all(grid[r][c] in CHAR_TO_LINKS\n",
    "               for (r, c) in parent if pristine[r][c] == \" \"), name\n",
    "    # DFS never finds a shorter path than BFS\n",
    "    bfs_depth = {n.position: n.depth\n",
    "                 for n in breadthfirstsearch([r[:] for r in pristine])}\n",
    "    assert all(n.depth >= bfs_depth[n.position] for n in found), name\n",
    "\n",
    "# --- saving the results (into a temporary folder) ------------------------------\n",
    "out = Path(tempfile.mkdtemp()) / \"results\"\n",
    "run_search_on_maps(depthfirstsearch, \"dfs\", \"./data\", str(out))\n",
    "files = sorted(p.name for p in out.iterdir())\n",
    "assert \"dfs_map1.txt\" in files and \"dfs_map3_goal12.txt\" in files\n",
    "assert \"dfs_map3_goal13.txt\" not in files\n",
    "assert len(files) == 3 + 4 + 10 + 12\n",
    "assert (out / \"dfs_map1.txt\").read_text(encoding=\"utf-8\").count(\"S\") == 1\n",
    "\n",
    "print(\"All tests passed.\")"
   ]
