    "import contextlib\n",
    "import io\n",
    "import tempfile\n",
    "from collections import deque\n",
    "from pathlib import Path\n",
    "\n",
    "# --- tiny map: shortest path, drawing --------------------------------------\n",
    "tiny = [list(r) for r in [\"#####\",\n",
    "                          \"#S *#\",\n",
    "                          \"# # #\",\n",
    "                          \"#   #\",\n",
    "                          \"#####\"]]\n",
    "goal_nodes = breadthfirstsearch(tiny)\n",
    "assert len(goal_nodes) == 1 and goal_nodes[0].depth == 2\n",
    "assert [n.position for n in goal_nodes[0].path()] == [(1, 1), (1, 2), (1, 3)]\n",
    "assert tiny[1][1] == \"S\" and tiny[1][3] == \"*\"      # markers are kept\n",
    "assert tiny[1][2] == \"\\u2500\"                        # ─ on the way to the goal\n",
    "assert all(tiny[r][c] in CHAR_TO_LINKS for r, c in [(2, 1), (3, 1), (3, 2), (3, 3), (2, 3)])\n",
    "\n",
    "# --- shortest path is chosen even if a longer way exists -------------------\n",
    "loop = [list(r) for r in [\"#######\",\n",
    "                          \"#S   *#\",\n",
    "                          \"# ### #\",\n",
    "                          \"#     #\",\n",
    "                          \"#######\"]]\n",
    "assert breadthfirstsearch(loop)[0].depth == 4\n",
    "\n",
    "# --- no reachable goal / no start ------------------------------------------\n",
    "assert breadthfirstsearch([list(r) for r in [\"####\", \"#S #\", \"####\"]]) == []\n",
    "try:\n",
    "    breadthfirstsearch([list(\"# #\")])\n",
    "    raise AssertionError(\"expected ValueError\")\n",
    "except ValueError:\n",
    "    pass\n",
    "\n",
    "# --- monitor flag ------------------------------------------------------------\n",
    "buf = io.StringIO()\n",
    "with contextlib.redirect_stdout(buf):\n",
    "    breadthfirstsearch([list(r) for r in [\"####\", \"#S*#\", \"####\"]])\n",
    "assert buf.getvalue() == \"\"                          # silent by default\n",
    "with contextlib.redirect_stdout(buf):\n",
    "    breadthfirstsearch([list(r) for r in [\"####\", \"#S*#\", \"####\"]], monitor=True)\n",
    "assert \"goal\" in buf.getvalue()\n",
    "\n",
    "# --- real maps: compare with an independent flood fill -----------------------\n",
    "def distances(grid, start):\n",
    "    d, q = {start: 0}, deque([start])\n",
    "    while q:\n",
    "        r, c = q.popleft()\n",
    "        for dr, dc in ((-1, 0), (0, 1), (1, 0), (0, -1)):\n",
    "            n = (r + dr, c + dc)\n",
    "            if grid[n[0]][n[1]] in \" S*\" and n not in d:\n",
    "                d[n] = d[(r, c)] + 1\n",
    "                q.append(n)\n",
    "    return d\n",
    "\n",
    "expected_found = {\"map1\": 4, \"map2\": 10, \"map3\": 12}   # map3: two goals are walled off\n",
    "for name in (\"map1\", \"map2\", \"map3\"):\n",
    "    grid, start, goals = load_map(f\"./data/{name}.txt\")\n",
    "    pristine = [r[:] for r in grid]\n",
    "    found = breadthfirstsearch(grid)\n",
    "    dist = distances(pristine, start)\n",
    "\n",
    "    assert len(found) == expected_found[name], name\n",
    "    assert {n.position for n in found} == {g for g in goals if g in dist}\n",
    "    assert [n.depth for n in found] == sorted(n.depth for n in found)   # nearest first\n",
    "    for n in found:\n",
    "        assert n.depth == dist[n.position]                              # shortest path\n",
    "        p = n.path()\n",
    "        assert p[0].position == start and p[-1] is n and len(p) == n.depth + 1\n",
    "        assert all(abs(a.position[0] - b.position[0]) + abs(a.position[1] - b.position[1]) == 1\n",
    "                   for a, b in zip(p, p[1:]))\n",
    "    # every reachable free cell was explored and drawn\n",
    "    assert all(grid[r][c] in CHAR_TO_LINKS\n",
    "               for (r, c) in dist if pristine[r][c] == \" \"), name\n",
    "\n",
    "# --- saving the results (into a temporary folder) -----------------------------\n",
    "out = Path(tempfile.mkdtemp()) / \"results\"\n",
    "run_bfs_on_maps(\"./data\", str(out))\n",
    "files = sorted(p.name for p in out.iterdir())\n",
    "assert \"bfs_map1.txt\" in files and \"bfs_map3_goal12.txt\" in files\n",
    "assert \"bfs_map3_goal13.txt\" not in files\n",
    "assert len(files) == 3 + 4 + 10 + 12\n",
    "text = (out / \"bfs_map1.txt\").read_text(encoding=\"utf-8\")\n",
    "assert text.count(\"S\") == 1 and \"\\u2500\" in text\n",
    "\n",
    "print(\"All tests passed.\")"
   ]
